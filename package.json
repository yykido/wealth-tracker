{
  "name": "wealth-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "preview": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "test": "node --import tsx --test src/domain/*.test.mjs src/storage/*.test.mjs server/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src app server db e2e *.json *.mjs *.ts README.md docs .github",
    "predev": "node scripts/prepare-ocr.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs",
    "install:ci": "node scripts/install-ci.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.0.11",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "drizzle-kit": "0.31.10",
    "fake-indexeddb": "^6.0.0",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.9.10",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "^19.3.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vinext": "^1.3.0",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "undici": "^7.30.1",
    "fflate": "^0.8.2"
  }
}
